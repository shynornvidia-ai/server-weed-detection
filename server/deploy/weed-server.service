# systemd unit cho phan 2 (server) — chay tren server Ubuntu, copy vao /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now weed-server
# Xem log: journalctl -u weed-server -f

[Unit]
Description=Weed Detector Server (Phan 2)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# >>> Doi user + duong dan cho dung voi server <<<
User=www-data
WorkingDirectory=/opt/weed-server/server
Environment=PATH=/opt/weed-server/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=WEED_SERVER_API_KEY=change-me-please
Environment=WEED_SERVER_DB=/opt/weed-server/data/weed_server.db
ExecStart=/opt/weed-server/.local/bin/uv run weed-server --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
